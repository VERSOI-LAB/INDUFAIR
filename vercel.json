{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/biz/new",
      "destination": "/biz-new"
    },
    {
      "source": "/biz/verify",
      "destination": "/biz-verify"
    },
    {
      "source": "/biz/:id",
      "destination": "/api/page?type=biz&id=:id"
    },
    {
      "source": "/product/:id",
      "destination": "/api/page?type=product&id=:id"
    },
    {
      "source": "/chat/:id",
      "destination": "/chat?id=:id"
    },
    {
      "source": "/profile/:id",
      "destination": "/profile?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{product,business}.html"
    }
  }
}
