{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/biz/new",
      "destination": "/biz-new"
    },
    {
      "source": "/biz/verify",
      "destination": "/biz-verify"
    },
    {
      "source": "/biz/:id",
      "destination": "/api/page?type=biz&id=:id"
    },
    {
      "source": "/product/:id",
      "destination": "/api/page?type=product&id=:id"
    },
    {
      "source": "/support/area/:v/:f",
      "destination": "/api/landing?kind=area&v=:v&f=:f"
    },
    {
      "source": "/support/area/:v",
      "destination": "/api/landing?kind=area&v=:v"
    },
    {
      "source": "/support/field/:v",
      "destination": "/api/landing?kind=field&v=:v"
    },
    {
      "source": "/support/:id",
      "destination": "/api/page?type=support&id=:id"
    },
    {
      "source": "/community/write",
      "destination": "/community"
    },
    {
      "source": "/community/admin",
      "destination": "/community"
    },
    {
      "source": "/community/:id",
      "destination": "/api/page?type=community&id=:id"
    },
    {
      "source": "/events",
      "destination": "/support"
    },
    {
      "source": "/events/:id",
      "destination": "/api/page?type=event&id=:id"
    },
    {
      "source": "/chat/:id",
      "destination": "/chat?id=:id"
    },
    {
      "source": "/profile/:id",
      "destination": "/profile?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{product,business,support,community}.html"
    },
    "api/landing.js": {
      "includeFiles": "support.html"
    }
  }
}
