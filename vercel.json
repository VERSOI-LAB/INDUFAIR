{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/biz/new",
      "destination": "/biz-new"
    },
    {
      "source": "/biz/verify",
      "destination": "/biz-verify"
    },
    {
      "source": "/biz/:id",
      "destination": "/api/page?type=biz&id=:id"
    },
    {
      "source": "/product/:id",
      "destination": "/api/page?type=product&id=:id"
    },
    {
      "source": "/rfq/:id",
      "destination": "/rfq"
    },
    {
      "source": "/price/:v",
      "destination": "/api/seo?kind=price&v=:v"
    },
    {
      "source": "/buy/c/:c",
      "destination": "/api/seo?kind=buy&c=:c"
    },
    {
      "source": "/buy/area/:a/:c",
      "destination": "/api/seo?kind=buy&area=:a&c=:c"
    },
    {
      "source": "/buy/area/:a",
      "destination": "/api/seo?kind=buy&area=:a"
    },
    {
      "source": "/social/weekly.json",
      "destination": "/api/social?manifest=1"
    },
    {
      "source": "/social/weekly/:file",
      "destination": "/api/social?file=:file"
    },
    {
      "source": "/support/weekly.jpg",
      "destination": "/api/weekly-image"
    },
    {
      "source": "/support/weekly",
      "destination": "/api/seo?kind=weekly"
    },
    {
      "source": "/support/weekly.json",
      "destination": "/api/seo?kind=weekly_json"
    },
    {
      "source": "/support/area/:v/:f",
      "destination": "/api/landing?kind=area&v=:v&f=:f"
    },
    {
      "source": "/support/area/:v",
      "destination": "/api/landing?kind=area&v=:v"
    },
    {
      "source": "/support/field/:v",
      "destination": "/api/landing?kind=field&v=:v"
    },
    {
      "source": "/support/:id",
      "destination": "/api/page?type=support&id=:id"
    },
    {
      "source": "/community/write",
      "destination": "/community"
    },
    {
      "source": "/community/admin",
      "destination": "/community"
    },
    {
      "source": "/community/:id",
      "destination": "/api/page?type=community&id=:id"
    },
    {
      "source": "/events",
      "destination": "/support"
    },
    {
      "source": "/events/:id",
      "destination": "/api/page?type=event&id=:id"
    },
    {
      "source": "/chat/:id",
      "destination": "/chat?id=:id"
    },
    {
      "source": "/profile/:id",
      "destination": "/profile?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{product,business,support,community}.html"
    },
    "api/landing.js": {
      "includeFiles": "support.html"
    },
    "api/weekly-image.js": {
      "includeFiles": "fonts/NanumSquareRound*.woff2",
      "memory": 1024
    },
    "api/social.js": {
      "includeFiles": "{fonts/NanumSquareRound*.woff2,이미지/stickers/*.webp,img/**}",
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
